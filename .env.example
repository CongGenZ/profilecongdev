# Copy file này thành .env.local rồi điền key thật vào

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claude AI — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Nodemailer SMTP (Dùng Gmail hoặc SMTP server bất kỳ)
# Với Gmail: Bật 2FA rồi tạo App Password (Mật khẩu ứng dụng) tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=obzv efkg tidc aieo
# Email nhận thông báo liên hệ (nếu không điền sẽ lấy SMTP_USER)
CONTACT_TO_EMAIL=your-email@gmail.com

# Telegram Bot — https://t.me/BotFather → /newbot
# TELEGRAM_CHAT_ID: lấy từ https://api.telegram.org/bot<TOKEN>/getUpdates sau khi nhắn bot 1 tin
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=123456789

# Secret token để bảo mật webhook endpoint (tự đặt chuỗi ngẫu nhiên)
# Dùng khi đăng ký webhook: setWebhook?url=...&secret_token=<giá trị này>
TELEGRAM_WEBHOOK_SECRET=your-random-secret-here
